{
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "triggers": {
            "When_a_file_is_created_(properties_only)": {
                "recurrence": {
                    "interval": 3,
                    "frequency": "Minute"
                },
                "evaluatedRecurrence": {
                    "interval": 3,
                    "frequency": "Minute"
                },
                "splitOn": "@triggerBody()",
                "metadata": {
                    "A8546FE4B5BBEFDD!93368": "/Handwritten Notes"
                },
                "type": "ApiConnection",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['onedrive']['connectionId']"
                        }
                    },
                    "method": "get",
                    "path": "/datasets/default/triggers/batch/onnewfilesv2",
                    "queries": {
                        "folderId": "A8546FE4B5BBEFDD!93368",
                        "includeSubfolders": false,
                        "maxFileCount": 1,
                        "simulate": false
                    }
                }
            }
        },
        "actions": {
            "Check_if_Supported_Image": {
                "actions": {},
                "runAfter": {
                    "Initialize_variable_-_imageFileExtension": [
                        "Succeeded"
                    ]
                },
                "else": {
                    "actions": {
                        "Check_if_PDF": {
                            "actions": {
                                "Create_JPG_file": {
                                    "runAfter": {
                                        "Convert_file_using_path": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "ApiConnection",
                                    "inputs": {
                                        "host": {
                                            "connection": {
                                                "name": "@parameters('$connections')['onedrive']['connectionId']"
                                            }
                                        },
                                        "method": "post",
                                        "body": "@body('Convert_file_using_path')",
                                        "path": "/datasets/default/files",
                                        "queries": {
                                            "folderPath": "/Handwritten Notes",
                                            "name": ".jpg"
                                        }
                                    },
                                    "runtimeConfiguration": {
                                        "contentTransfer": {
                                            "transferMode": "Chunked"
                                        }
                                    }
                                },
                                "Terminate_-_Skip": {
                                    "runAfter": {
                                        "Move_converted_file": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "Terminate",
                                    "inputs": {
                                        "runStatus": "Cancelled"
                                    }
                                },
                                "Convert_file_using_path": {
                                    "type": "ApiConnection",
                                    "inputs": {
                                        "host": {
                                            "connection": {
                                                "name": "@parameters('$connections')['onedrive']['connectionId']"
                                            }
                                        },
                                        "method": "get",
                                        "path": "/datasets/default/ConvertFileByPath",
                                        "queries": {
                                            "path": "/Handwritten Notes/@{triggerBody()?['Name']}",
                                            "type": "PDF"
                                        }
                                    }
                                },
                                "Move_converted_file": {
                                    "runAfter": {
                                        "Create_JPG_file": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "ApiConnection",
                                    "inputs": {
                                        "host": {
                                            "connection": {
                                                "name": "@parameters('$connections')['onedrive']['connectionId']"
                                            }
                                        },
                                        "method": "post",
                                        "path": "/datasets/default/MoveFileByPath",
                                        "queries": {
                                            "source": "/Handwritten Notes/@{triggerBody()?['Name']}",
                                            "destination": "/Handwritten Notes/processed/@{triggerBody()?['Name']}",
                                            "overwrite": false
                                        }
                                    }
                                }
                            },
                            "else": {
                                "actions": {
                                    "Terminate_-_Unsupported": {
                                        "type": "Terminate",
                                        "inputs": {
                                            "runStatus": "Failed",
                                            "runError": {
                                                "code": "400",
                                                "message": "Image type is not supported. Supported types: jpg, gif, png, bmp, tiff."
                                            }
                                        }
                                    }
                                }
                            },
                            "expression": {
                                "and": [
                                    {
                                        "equals": [
                                            "",
                                            ""
                                        ]
                                    }
                                ]
                            },
                            "type": "If"
                        }
                    }
                },
                "expression": {
                    "or": [
                        {
                            "equals": [
                                "@variables('imageFileExtension')",
                                "jpg"
                            ]
                        },
                        {
                            "equals": [
                                "@variables('imageFileExtension')",
                                "jpeg"
                            ]
                        },
                        {
                            "equals": [
                                "@variables('imageFileExtension')",
                                "png"
                            ]
                        },
                        {
                            "equals": [
                                "@variables('imageFileExtension')",
                                "gif"
                            ]
                        },
                        {
                            "equals": [
                                "@variables('imageFileExtension')",
                                "bmp"
                            ]
                        },
                        {
                            "equals": [
                                "@variables('imageFileExtension')",
                                "tiff"
                            ]
                        }
                    ]
                },
                "type": "If"
            },
            "Create_markdown_file": {
                "runAfter": {
                    "Copy_file_using_path": [
                        "Succeeded"
                    ]
                },
                "type": "ApiConnection",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['onedrive']['connectionId']"
                        }
                    },
                    "method": "post",
                    "body": "---\nnote-type: @{body('Parse_JSON_-_Get_ExtractNotes_Response')?['noteType']}\ncreated-date: @{formatDateTime(addToTime(utcNow(),8,'Hour'),'yyyy-MM-dd HH:mm')}\nlast-updated: @{formatDateTime(addToTime(utcNow(),8,'Hour'),'yyyy-MM-dd HH:mm')}\n---\n![[@{body('Parse_JSON_-_Get_ExtractNotes_Response')?['extractedTitle']}.@{variables('imageFileExtension')}]]\n\n@{body('Parse_JSON_-_Get_ExtractNotes_Response')?['extractedText']}",
                    "path": "/datasets/default/files",
                    "queries": {
                        "folderPath": "/second-brain/second-brain/_fleeting-notes",
                        "name": "@{body('Parse_JSON_-_Get_ExtractNotes_Response')?['extractedTitle']}.md"
                    }
                },
                "runtimeConfiguration": {
                    "contentTransfer": {
                        "transferMode": "Chunked"
                    }
                }
            },
            "Get_Functions_Secret": {
                "runAfter": {
                    "Check_if_Supported_Image": [
                        "Succeeded"
                    ]
                },
                "type": "ApiConnection",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['keyvault']['connectionId']"
                        }
                    },
                    "method": "get",
                    "path": "/secrets/@{encodeURIComponent('raznotesapi-defaultkey')}/value"
                },
                "runtimeConfiguration": {
                    "secureData": {
                        "properties": [
                            "outputs"
                        ]
                    }
                }
            },
            "HTTP_-_Extract_Notes": {
                "runAfter": {
                    "Get_Functions_Secret": [
                        "Succeeded"
                    ]
                },
                "type": "Http",
                "inputs": {
                    "uri": "https://raznotesapi.azurewebsites.net/api/ExtractNotes?code=@{body('Get_Functions_Secret')?['value']}",
                    "method": "POST",
                    "body": {
                        "$content-type": "multipart/form-data",
                        "$multipart": [
                            {
                                "body": "@body('Get_file_content_using_path')",
                                "headers": {
                                    "Content-Disposition": "form-data; name=image; filename=\"\"",
                                    "Content-Type": "@{body('Get_file_content_using_path')}"
                                }
                            }
                        ]
                    }
                },
                "runtimeConfiguration": {
                    "contentTransfer": {
                        "transferMode": "Chunked"
                    }
                }
            },
            "Initialize_variable_-_imageFileExtension": {
                "runAfter": {
                    "Get_file_content_using_path": [
                        "Succeeded"
                    ]
                },
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "imageFileExtension",
                            "type": "string",
                            "value": "@last(split(triggerBody()?['Name'],'.'))"
                        }
                    ]
                }
            },
            "Parse_JSON_-_Get_ExtractNotes_Response": {
                "runAfter": {
                    "HTTP_-_Extract_Notes": [
                        "Succeeded"
                    ]
                },
                "type": "ParseJson",
                "inputs": {
                    "content": "@body('HTTP_-_Extract_Notes')",
                    "schema": {
                        "properties": {
                            "extractedText": {
                                "type": "string"
                            },
                            "extractedTitle": {
                                "type": "string"
                            },
                            "noteType": {
                                "type": "string"
                            }
                        },
                        "type": "object"
                    }
                }
            },
            "Get_file_metadata_using_path": {
                "runAfter": {},
                "type": "ApiConnection",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['onedrive']['connectionId']"
                        }
                    },
                    "method": "get",
                    "path": "/datasets/default/GetFileByPath",
                    "queries": {
                        "path": "/Handwritten Notes/@{triggerBody()?['Name']}"
                    }
                }
            },
            "Get_file_content_using_path": {
                "runAfter": {
                    "Get_file_metadata_using_path": [
                        "Succeeded"
                    ]
                },
                "type": "ApiConnection",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['onedrive']['connectionId']"
                        }
                    },
                    "method": "get",
                    "path": "/datasets/default/GetFileContentByPath",
                    "queries": {
                        "path": "/Handwritten Notes/@{triggerBody()?['Name']}",
                        "inferContentType": true
                    }
                }
            },
            "Copy_file_using_path": {
                "runAfter": {
                    "Parse_JSON_-_Get_ExtractNotes_Response": [
                        "Succeeded"
                    ]
                },
                "type": "ApiConnection",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['onedrive']['connectionId']"
                        }
                    },
                    "method": "post",
                    "path": "/datasets/default/CopyFileByPath",
                    "queries": {
                        "source": "/Handwritten Notes/@{triggerBody()?['Name']}",
                        "destination": "/second-brain/second-brain/_fleeting-notes/@{body('Parse_JSON_-_Get_ExtractNotes_Response')?['extractedTitle']}.@{variables('imageFileExtension')}",
                        "overwrite": false
                    }
                }
            },
            "Move_Processed_File": {
                "runAfter": {
                    "Create_markdown_file": [
                        "Succeeded"
                    ]
                },
                "type": "ApiConnection",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['onedrive']['connectionId']"
                        }
                    },
                    "method": "post",
                    "path": "/datasets/default/MoveFileByPath",
                    "queries": {
                        "source": "/Handwritten Notes/@{triggerBody()?['Name']}",
                        "destination": "/Handwritten Notes/processed/@{triggerBody()?['Name']}",
                        "overwrite": true
                    }
                }
            }
        },
        "outputs": {},
        "parameters": {
            "$connections": {
                "type": "Object",
                "defaultValue": {}
            }
        }
    },
    "parameters": {
        "$connections": {
            "value": {
                "onedrive": {
                    "id": "/subscriptions/',subscription().subscriptionId,'/providers/Microsoft.Web/locations/',resourceGroup().location,'/managedApis/onedrive",
                    "connectionId": "/subscriptions/',subscription().subscriptionId,'/resourceGroups/',resourceGroup().name,'/providers/Microsoft.Web/connections/onedrive",
                    "connectionName": "onedrive"
                },
                "keyvault": {
                    "id": "/subscriptions/',subscription().subscriptionId,'/providers/Microsoft.Web/locations/',resourceGroup().location,'/managedApis/keyvault",
                    "connectionId": "/subscriptions/',subscription().subscriptionId,'/resourceGroups/',resourceGroup().name,'/providers/Microsoft.Web/connections/keyvault",
                    "connectionName": "keyvault",
                    "connectionProperties": {
                        "authentication": {
                            "type": "ManagedServiceIdentity"
                        }
                    }
                }
            }
        }
    }
}